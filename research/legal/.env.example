# Copy to research/legal/.env.local (git-ignored). Values already set in the environment win.
# All optional: without keys, `legal-research run` still reads official pages and data.ny.gov directly.

# --search: find niche programs that aren't on the index pages (Nimble is the fallback)
TAVILY_API_KEY=
NIMBLE_API_KEY=
# Official pages that block direct requests (nysenate.gov, amlegal NYC code)
FIRECRAWL_API_KEY=
# Optional: higher rate limits on data.ny.gov
# SOCRATA_APP_TOKEN=
