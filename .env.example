# Copy to .env and fill locally. Never commit real secrets.

# Anchor (optional; not used for NY search)
ANCHOR_API_KEY=

# AWS Bedrock agent runtime
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# SurrealDB memory / claim events
SURREAL_URL=
SURREAL_WS_URL=
SURREAL_NAMESPACE=moneyfinder
SURREAL_DATABASE=main
SURREAL_TOKEN=

# Daytona browser sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Arize evaluations
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# ElevenLabs (optional multilingual data entry)
ELEVENLABS_API_KEY=
