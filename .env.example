# Copy to .env and fill locally. Never commit real secrets.

# Nicrron gateway (MONEY TALKS 2 required sponsor) — OpenAI-compatible endpoint
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto

# PRISM by Block Convey (MONEY TALKS 2 required sponsor)
# Credential is proven with: POST $PRISMTRACE_HOST/api/setup-doctor/handshake
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Anchor (optional; not used for NY search)
ANCHOR_API_KEY=

# AWS Bedrock agent runtime
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# SurrealDB memory / claim events
SURREAL_URL=
SURREAL_WS_URL=
SURREAL_NAMESPACE=moneyfinder
SURREAL_DATABASE=main
SURREAL_TOKEN=

# Daytona browser sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Arize AX tracing / evaluations (OTLP to otlp.arize.com — not GraphQL)
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=moneyfinder

# ElevenLabs (optional MONEY TALKS 2 sponsor) — voice onboarding + spoken status
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Company research providers (loaded by research/company from this root .env)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
NIMBLE_API_KEY=
SOCRATA_APP_TOKEN=

# Point the API at a downloaded/imported NY TSV or JSON file.
# Leave unset for the explicitly labeled synthetic demo corpus.
NY_UNCLAIMED_DATA_FILE=
