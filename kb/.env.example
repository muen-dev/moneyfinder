# Copy to kb/.env

# SurrealDB: local (docker compose / surreal start) or a SurrealDB Cloud instance (wss://...)
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=moneyfinder
SURREAL_DB=kb

# Raw + extracted files. A local folder, or s3://bucket/prefix
# LAKE_URI=s3://moneyfinder-lake/kb

# Amazon Bedrock embeddings. Leave EMBED_MODEL unset to run full-text search only.
AWS_REGION=us-east-1
# EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# Cleaner markdown for HTML pages (optional; falls back to a built-in extractor)
FIRECRAWL_API_KEY=
