# Optional: copy to kb/.env. Without it, kb uses the repo-root .env (SurrealDB Cloud, ns moneyfinder, db main).
# Values here override the root .env per key; exported shell variables override both.

# SurrealDB, local (docker compose / surreal start). Cloud: SURREAL_WS_URL=wss://..., SURREAL_NAMESPACE,
# SURREAL_DATABASE, and a database-level SURREAL_USER/SURREAL_PASS (or a JWT in SURREAL_TOKEN).
# The blank long names below stop the root .env's cloud values from winning over the local short names.
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_WS_URL=
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=moneyfinder
SURREAL_NAMESPACE=
SURREAL_DB=kb
SURREAL_DATABASE=

# Raw + extracted files. A local folder, or s3://bucket/prefix
# LAKE_URI=s3://moneyfinder-lake/kb

# Amazon Bedrock embeddings. Leave EMBED_MODEL unset to run full-text search only.
AWS_REGION=us-east-1
# EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# Cleaner markdown for HTML pages (optional; falls back to a built-in extractor)
FIRECRAWL_API_KEY=
